# Server
PORT=4021
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4021

# Payment
# Base Sepolia (testnet) is the default for safe development.
NETWORK=eip155:84532
# Your receiving wallet (EIP-55). Required for live facilitator settlement.
PAY_TO=0xYourReceivingAddress
# Display + requirement price (x402 Money string)
PRICE=$0.001
# Facilitator (public test facilitator supports Base Sepolia)
FACILITATOR_URL=https://x402.org/facilitator
# true = local DemoFacilitatorClient (no chain). false = live HTTP facilitator.
DEMO_MODE=true

# Budgets (atomic USDC units; Base USDC has 6 decimals → 100000 = $0.10)
DEFAULT_AGENT_BUDGET_ATOMIC=100000
# Comma-separated payer=budgetAtomic overrides
# AGENT_BUDGETS=0xabc...=50000,0xdef...=200000

# Receipts
RECEIPTS_DIR=./data/receipts

# Live client only (never commit real keys):
# PRIVATE_KEY=0x...
