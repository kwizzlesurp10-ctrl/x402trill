# Server
PORT=4021
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4021

# Payment — Base mainnet USDC (Keith's wallet is the code default when unset)
NETWORK=eip155:8453
# Prefer X402_PAY_TO; PAY_TO is supported for backward compatibility
X402_PAY_TO=0x0d25A44f74868eCE53B305C97139CF4B62963410
# PAY_TO=0x0d25A44f74868eCE53B305C97139CF4B62963410
# Display + requirement price (x402 Money string)
PRICE=$0.001
FACILITATOR_URL=https://x402.org/facilitator
# true = local DemoFacilitatorClient (no chain). false = live HTTP facilitator.
DEMO_MODE=true

# Testnet override (optional local dev against Base Sepolia)
# NETWORK=eip155:84532

# Budgets (atomic USDC units; Base USDC has 6 decimals → 100000 = $0.10)
DEFAULT_AGENT_BUDGET_ATOMIC=100000
# Comma-separated payer=budgetAtomic overrides
# AGENT_BUDGETS=0xabc...=50000,0xdef...=200000

# Receipts
RECEIPTS_DIR=./data/receipts

# Live client only (never commit real keys):
# PRIVATE_KEY=0x...
