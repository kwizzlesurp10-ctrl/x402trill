# Whitelist monorepo surfaces (repo root may be nested in larger trees)
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/.github/
!/.github/**
!/.grok/
!/.grok/**
!/webapp/
!/webapp/**
!/aetherweb/
!/aetherweb/**
!/paid-mcp/
!/paid-mcp/**
!/docs/
!/docs/**

# Next / Node (inside app)
webapp/node_modules/
webapp/.next/
webapp/out/
webapp/coverage/
webapp/.turbo/
webapp/.vercel/
webapp/*.tsbuildinfo

# App env
webapp/.env
webapp/.env*.local

# paid-mcp
paid-mcp/node_modules/
paid-mcp/dist/
paid-mcp/data/
paid-mcp/.env
paid-mcp/*.tsbuildinfo
